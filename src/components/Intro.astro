
---
import FractalTree from './FractalTree.astro';
---

<section class="intro-section" id="home">
  <div class="scene">
    <FractalTree />
  </div>

  <div class="intro">
    <p class="eyebrow">A LITTLE INTRODUCTION</p>

     <h1>hey, i'm <span>sakshi</span>.<span class="blinking-cursor" aria-hidden="true"></span></h1>

    <p class="intro-copy">
      I'm learning my way through the world of software, figuring things
      out by building, breaking, fixing, and trying again. I enjoy
      exploring different corners of technology, experimenting with
      ideas, and occasionally getting lost in interesting rabbit holes
      along the way. There's always something new to learn, make, or
      get curious about.
    </p>

    <a href="mailto:sakshidb.dev@gmail.com" class="say-hi-button">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect x="3" y="5" width="18" height="14" rx="2" />
    <path d="m3 7 9 6 9-6" />
  </svg>
  <span>Say hi!</span>
</a>

  </div>

</section>

<style>
  .intro-section {
    max-width: var(--page-width);
    min-height: 76vh;
    margin: 0 auto;
    padding: 4rem var(--page-padding);
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 3rem;
    overflow: hidden;
  }

  .scene {
    width: 100%;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .intro {
    max-width: 540px;
  }

  .eyebrow {
    font-family: var(--font-mono);
    color: var(--color-accent);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
  }

  h1 {
    font-family: var(--font-heading);
    color: var(--color-text);
    font-size: clamp(2.6rem, 4.5vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    margin: 1.1rem 0;
  }

  h1 span {
    color: var(--color-accent);
  }

  .intro-copy {
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.9;
  }

  @media (max-width: 768px) {
    .intro-section {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-top: 3rem;
      gap: 1.5rem;
    }

    .scene {
      order: 1;
    }

    .intro {
      order: 2;
      max-width: 100%;
    }
  }
</style>
