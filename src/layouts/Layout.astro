---
import '../styles/global.css';
import Explorer from '../components/Explorer.astro';

const { title = 'Sakshi Bhosale' } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="A personal space for ideas, experiments, and things being built." />
        <meta name="theme-color" content="#111318" />

        <link rel="icon" type="image/jpeg" href="/favicon.jpg" />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
             href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Nunito+Sans:wght@400;500;600;700;800&display=swap"
             rel="stylesheet"
         />

		<title>{title}</title>

    </head>

    <body>
        <slot />
        <Explorer />
    </body>
</html>

<style>
    :global(*) {
        box-sizing: border-box;
    }

    :global(html) {
        background: #111318;
        color: #e7e2d8;
        font-family: Arial, sans-serif;
    }

    :global(body) {
        margin: 0;
        min-height: 100vh;
    }
</style>
