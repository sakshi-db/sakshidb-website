                  ></path></svg
                >
                Java
              </li>
              <li>
                <svg class="tech-icon" viewBox="0 0 24 24"
                  ><path
                    fill="currentColor"
                    d="M14.25 2.09c.14 0 .28.02.42.05 1.15.26 2.03 1.19 2.24 2.34l.32 1.74h-3.32l-.12-.62c-.11-.56-.63-.98-1.21-.98H9.37c-.63 0-1.15.48-1.21 1.11l-.04.45h4.13c1.66 0 3.01 1.35 3.01 3.01v.96h1.96c.74 0 1.35.61 1.35 1.35v3.42c0 .74-.61 1.35-1.35 1.35h-1.96v.96c0 1.66-1.35 3.01-3.01 3.01H9.37c-1.66 0-3.01-1.35-3.01-3.01v-3.42c0-.74.61-1.35 1.35-1.35h1.96v-.96c0-1.15.93-2.08 2.08-2.08h4.25c.34 0 .61-.27.61-.61V8.89c0-.34-.27-.61-.61-.61H10.5c-1.66 0-3.01-1.35-3.01-3.01v-.45c0-1.66 1.35-3.01 3.01-3.01h3.75z"
                  ></path></svg
                >
                Python
              </li>
              <li>
                <svg class="tech-icon" viewBox="0 0 24 24"
                  ><path
                    fill="currentColor"
                    d="M18.15 2.5H5.85C4.01 2.5 2.5 4.01 2.5 5.85v12.3c0 1.84 1.51 3.35 3.35 3.35h12.3c1.84 0 3.35-1.51 3.35-3.35V5.85c0-1.84-1.51-3.35-3.35-3.35zm-9.4 15.65H7.2V8.9h1.55v9.25zm8.05 0h-6.2v-1.5h6.2v1.5zm0-3.5h-6.2v-1.5h6.2v1.5z"
                  ></path></svg
                >
                Astro
              </li>
              <li>
                <svg class="tech-icon" viewBox="0 0 24 24"
                  ><path
                    fill="currentColor"
                    d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8zm1-13h-2v6h6v-2h-4z"
                  ></path></svg
                >
                TypeScript
              </li>
              <li>
                <svg class="tech-icon" viewBox="0 0 24 24"
                  ><path
                    fill="currentColor"
                    d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15h-2v-6h2v6zm1-8H11V7h2v2z"
                  ></path></svg
                >
                React.js
              </li>
              <li>
                <svg class="tech-icon" viewBox="0 0 24 24"
                  ><path
                    fill="currentColor"
                    d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"
                  ></path></svg
                >
                Tailwind CSS
              </li>
              <li>
                <svg class="tech-icon" viewBox="0 0 24 24"
                  ><path
                    fill="currentColor"
                    d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 14h-2v-2h2v2zm0-4h-2V7h2v5z"
                  ></path></svg
